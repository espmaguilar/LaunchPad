# Copy to .env and fill in. Never commit .env.
# AWS credentials are NOT stored here: use ~/.aws/credentials or AWS_PROFILE.
AWS_REGION=us-east-1
# Bedrock model ID (enable model access in the Bedrock console first).
# Default: Claude Opus 5.5. Faster/cheaper alternative: anthropic.claude-haiku-5-5
# If Bedrock says on-demand isn't supported, use the inference-profile ID shown in the
# console for your region instead. Empty = template reports (no Bedrock call).
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# Must be globally unique, lowercase, e.g. safesight-<yourname>-2026
S3_BUCKET=
# Printed by setup_aws.py after it creates the topic
SNS_TOPIC_ARN=
ALERT_EMAIL=you@example.com

# true = no AWS calls: fake detections + default zones (for UI testing)
MOCK_MODE=false

# true = short escalation timers for demos (email 20s, escalation 60s, resolve 10s)
# false = production timers (120s / 600s / 30s)
DEMO_MODE=true

# Ignore people smaller than this fraction of the frame (background bystanders). 0 = check everyone.
MIN_PERSON_AREA=0
