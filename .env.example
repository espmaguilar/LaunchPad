# Copy to .env and fill in. Never commit .env.
# AWS credentials are NOT stored here: use ~/.aws/credentials, AWS_PROFILE or your
# workshop's temporary credentials in the environment.
AWS_REGION=us-east-1

# Bedrock model (must be enabled in your account). It reads lab manuals and, in later
# phases, watches the camera, so it should accept images. Use the inference-profile ID
# for your region, e.g. us.meta.llama4-scout-17b-instruct-v1:0 or us.anthropic.claude-haiku-5-5
BEDROCK_MODEL_ID=
# Used automatically if BEDROCK_MODEL_ID can't take images
# VISION_FALLBACK_MODEL_ID=us.amazon.nova-lite-v1:0

# Must be globally unique, lowercase, e.g. labscribe-<yourname>-2026
S3_BUCKET=

# true = no AWS calls: local files in mock_data/, steps read from the manual's numbered list
MOCK_MODE=false

# Background filter: ignore people smaller than this fraction of the frame. 0 = everyone.
MIN_PERSON_AREA=0

# Optional: ElevenLabs voice for spoken guidance (falls back to Amazon Polly if empty or failing)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=dmWfLQZJq7wNPv9WmtiM
